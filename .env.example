# Supabase project settings (use the Project URL and anon/publishable key only in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. NEVER prefix this with NEXT_PUBLIC_ or expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Public canonical URL used for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://muhammadwasiportfolio.vercel.app
